# source is where the preferred place to download necessary gems is
source 'https://rubygems.org'
# which version of the ruby language interpreter is required
ruby  '3.3.8'

# we want version 4.0 or later of the sinatra gem
gem 'sinatra', '~> 4.0'
# helps us deploy our application
gem 'rackup'
# provides us with a web server to communicate with
gem 'webrick'